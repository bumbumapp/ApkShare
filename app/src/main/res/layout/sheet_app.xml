<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/sheet_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheet_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/Bento.Text.TitleLarge" />

            <TextView
                android:id="@+id/sheet_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/Bento.Text.BodySmall" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/sheet_split_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bento_icon_square"
        android:backgroundTint="@color/bento_tile_yellow_bg"
        android:padding="12dp"
        android:text="@string/split_note"
        android:textAppearance="@style/Bento.Text.BodySmall"
        android:textColor="@color/bento_tile_yellow_fg"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sheet_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/action_share"
        app:icon="@drawable/ic_b_share"
        app:iconGravity="textStart" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_save"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_save"
            app:backgroundTint="?attr/colorSurfaceContainerHigh"
            app:icon="@drawable/ic_b_save"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_info"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/action_info"
            app:backgroundTint="?attr/colorSurfaceContainerHigh"
            app:icon="@drawable/ic_b_info"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
